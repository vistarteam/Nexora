# =============================================================================
# NEXORA — environment template
# Copy to `.env` at the repository root:  cp .env.example .env
# Never commit the real `.env`. No real credentials belong in this file.
# =============================================================================

# ---------- Runtime ----------
NODE_ENV=development
# Backend HTTP port
PORT=4000
# Comma-separated list of allowed browser origins (frontend dev server, etc.)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# debug | info | warn | error
LOG_LEVEL=info

# ---------- Market data ----------
# Which market-data provider the backend should use.
#   auto    -> crypto from Nobitex (Iranian exchange, keyless) + forex/equities
#              from Yahoo Finance (keyless). Both reachable on Iranian networks
#              without a proxy — DEFAULT.
#   nobitex -> real public candles from Nobitex's UDF history API (crypto, no key)
#   yahoo   -> real public candles from Yahoo Finance chart API (forex + equities, no key)
#   binance -> real public candles from the Binance REST API (crypto; blocked from Iranian IPs)
#   none    -> no data; endpoints answer with an explicit "unavailable" status
# Crypto is always quoted in tether (USDT), never in rial: the catalog and both
# crypto sources use USDT-quoted tickers such as BTCUSDT.
# There is no synthetic/demo mode: every candle is real, or the request fails.
MARKET_DATA_PROVIDER=auto

# Optional. Only needed by providers that require authentication (Nobitex, Yahoo
# and Binance are keyless; reserved for a paid/free-tier provider such as
# Twelve Data, Alpha Vantage, Polygon or Finnhub).
MARKET_DATA_API_KEY=
# Optional base URL override for credentialed providers, and for Binance.
MARKET_DATA_BASE_URL=
# Optional origin overrides for the Iran-reachable providers. Leave empty for the
# built-in defaults (https://apiv2.nobitex.ir and https://query1.finance.yahoo.com);
# set them to route through a mirror if a network blocks the direct origin.
MARKET_DATA_NOBITEX_BASE_URL=
MARKET_DATA_YAHOO_BASE_URL=
# Upstream request timeout in milliseconds.
MARKET_DATA_TIMEOUT_MS=8000
# Candle request cap (providers may return fewer).
MARKET_DATA_MAX_LIMIT=1000

# Default instrument shown when the user has not chosen anything yet.
DEFAULT_SYMBOL=BINANCE:BTCUSDT
DEFAULT_TIMEFRAME=1h

# ---------- Python analysis engine ----------
# Executable used to spawn the engine. Use `python3` on Linux/macOS if needed.
ANALYSIS_ENGINE_PYTHON=python
# Hard timeout for one engine invocation (milliseconds).
ANALYSIS_ENGINE_TIMEOUT_MS=15000
# Allow falling back to an in-process TypeScript reference implementation when
# the Python engine cannot be spawned. The report records which engine ran.
ANALYSIS_ENGINE_FALLBACK_TS=true

# ---------- Storage ----------
# json   -> persists to STORAGE_DIR as JSON documents (survives restarts)
# memory -> in-process only; responses report persistent: false
STORAGE_DRIVER=json
STORAGE_DIR=.data
# When set, the storage layer is ready for a PostgreSQL driver swap.
# (No PostgreSQL driver ships in this MVP — see docs/ARCHITECTURE.md.)
DATABASE_URL=
