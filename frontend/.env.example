# =============================================================================
# NEXORA frontend — build-time configuration
# Only VITE_-prefixed variables reach the browser bundle.
# NEVER put API keys or secrets here: anything in this file is public.
# =============================================================================

# Base URL of the backend API.
# Leave empty in development: Vite proxies /api to http://localhost:4000.
# In production set the full origin, e.g. https://api.nexora.example
VITE_API_BASE_URL=

# Where the Vite dev server proxies /api during development.
VITE_PROXY_TARGET=http://localhost:4000
